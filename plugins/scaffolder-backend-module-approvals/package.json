{
  "name": "@ferin79/backstage-plugin-scaffolder-backend-module-approvals",
  "description": "The approval:gate scaffolder action, which blocks a template until its approval request is granted",
  "version": "0.0.1",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ]
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ferin79/backstage-scaffolder-approvals",
    "directory": "plugins/scaffolder-backend-module-approvals"
  },
  "backstage": {
    "role": "backend-plugin-module",
    "pluginId": "scaffolder",
    "pluginPackage": "@backstage/plugin-scaffolder-backend"
  },
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "^1.10.1",
    "@backstage/plugin-scaffolder-node": "^0.13.7",
    "@backstage/types": "^1.2.2",
    "@ferin79/backstage-plugin-scaffolder-approvals-common": "workspace:^",
    "@ferin79/backstage-plugin-scaffolder-approvals-node": "workspace:^"
  },
  "devDependencies": {
    "@backstage/backend-test-utils": "^1.11.7",
    "@backstage/cli": "^0.36.6",
    "@backstage/plugin-catalog-node": "^2.2.5",
    "@backstage/plugin-scaffolder-node-test-utils": "^0.3.15",
    "@ferin79/backstage-plugin-scaffolder-approvals-backend": "workspace:^"
  },
  "files": [
    "dist"
  ]
}
