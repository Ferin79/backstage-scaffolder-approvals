{
  "name": "@ferin79/backstage-plugin-catalog-backend-module-approvals",
  "description": "Derives the scaffolder-approvals gated annotation from an approval:gate step",
  "version": "0.1.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ]
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ferin79/backstage-scaffolder-approvals",
    "directory": "plugins/catalog-backend-module-approvals"
  },
  "backstage": {
    "role": "backend-plugin-module",
    "pluginId": "catalog",
    "pluginPackage": "@backstage/plugin-catalog-backend"
  },
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "^1.10.1",
    "@backstage/catalog-model": "^1.10.1",
    "@backstage/plugin-catalog-node": "^2.2.5",
    "@backstage/plugin-scaffolder-common": "^2.3.0",
    "@ferin79/backstage-plugin-scaffolder-approvals-common": "workspace:^"
  },
  "devDependencies": {
    "@backstage/backend-test-utils": "^1.11.7",
    "@backstage/cli": "^0.36.6"
  },
  "files": [
    "dist"
  ]
}
